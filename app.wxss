page {
  background: #fbf9f4;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  color: #29241c;
}

view, text, button {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #fdfbf6 0%, #f7f2e7 55%, #efe7d8 100%);
  padding-bottom: 60rpx;
}

.hero {
  padding: 90rpx 0 30rpx;
  text-align: center;
}
.hero .kicker {
  font-size: 22rpx;
  letter-spacing: 12rpx;
  color: #8a2f23;
  opacity: .8;
}
.hero .title {
  margin-top: 26rpx;
  font-size: 84rpx;
  font-weight: 700;
  letter-spacing: 16rpx;
  color: #241c12;
  text-indent: 16rpx;
}
.hero .sub {
  margin-top: 22rpx;
  font-size: 26rpx;
  color: #6b5f4e;
  letter-spacing: 4rpx;
}

.stat {
  margin: 50rpx auto 0;
  width: 600rpx;
  display: flex;
  border: 1rpx solid #e2d8c6;
  border-radius: 20rpx;
  background: rgba(255,255,255,.6);
  overflow: hidden;
}
.stat .cell {
  flex: 1;
  padding: 26rpx 0;
  text-align: center;
}
.stat .cell + .cell {
  border-left: 1rpx solid #e2d8c6;
}
.stat .num {
  font-size: 46rpx;
  color: #8a2f23;
  font-weight: 700;
  line-height: 1.1;
}
.stat .lab {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8a8175;
  letter-spacing: 2rpx;
}

.btn-main {
  margin: 60rpx auto 0;
  width: 600rpx;
  height: 104rpx;
  line-height: 104rpx;
  text-align: center;
  background: #8a2f23;
  color: #fff;
  font-size: 34rpx;
  letter-spacing: 12rpx;
  border-radius: 999rpx;
  border: none;
  font-weight: 700;
  box-shadow: 0 10rpx 30rpx rgba(138,47,35,.28);
}
.btn-main::after { border: none; }
.btn-main:active { opacity: .86; }

.btn-ghost {
  margin: 24rpx auto 0;
  width: 600rpx;
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  background: rgba(255,255,255,.7);
  color: #5c4d35;
  font-size: 28rpx;
  letter-spacing: 6rpx;
  border-radius: 999rpx;
  border: 1rpx solid #ddd0b8;
}
.btn-ghost::after { border: none; }
.btn-ghost:active { opacity: .8; }

.rules {
  margin: 56rpx auto 0;
  width: 620rpx;
  background: rgba(255,255,255,.55);
  border: 1rpx solid #e8dfd0;
  border-radius: 24rpx;
  padding: 30rpx 32rpx;
}
.rules .rt {
  font-size: 24rpx;
  letter-spacing: 6rpx;
  color: #8a2f23;
  margin-bottom: 16rpx;
}
.rules .ri {
  font-size: 25rpx;
  line-height: 1.95;
  color: #5f5443;
}
.rules .ri text {
  color: #8a2f23;
}

.topbar {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx 0;
}
.topbar .qno {
  flex: 1;
  font-size: 26rpx;
  color: #7a6c58;
  letter-spacing: 2rpx;
}
.topbar .scorebox {
  font-size: 44rpx;
  font-weight: 700;
  color: #8a2f23;
  line-height: 1;
}
.topbar .scorebox .unit {
  font-size: 22rpx;
  margin-left: 6rpx;
  font-weight: 400;
}
.topbar .combo {
  margin-left: 20rpx;
  font-size: 22rpx;
  color: #a89a83;
  letter-spacing: 2rpx;
  opacity: 0;
  transition: opacity .2s;
}
.topbar .combo.on {
  opacity: 1;
  color: #8a2f23;
  font-weight: 700;
}

.pbar {
  margin: 22rpx 32rpx 0;
  height: 8rpx;
  background: #ece2d0;
  border-radius: 999rpx;
  overflow: hidden;
}
.pfill {
  height: 100%;
  background: #c9b79a;
  border-radius: 999rpx;
  transition: width .25s ease;
}
.tbar {
  margin: 10rpx 32rpx 0;
  height: 6rpx;
  background: #f0e8da;
  border-radius: 999rpx;
  overflow: hidden;
}
.tfill {
  height: 100%;
  background: #3f5f52;
  border-radius: 999rpx;
}
.tfill.warn { background: #8a2f23; }

.stage {
  padding: 70rpx 40rpx 40rpx;
  text-align: center;
}
.stage .hint {
  font-size: 26rpx;
  letter-spacing: 8rpx;
  color: #9a8c76;
}
.stage .line {
  margin-top: 36rpx;
  padding: 0 10rpx;
  font-size: 48rpx;
  line-height: 2;
  color: #241c12;
  letter-spacing: 2rpx;
  text-align: justify;
  text-align-last: center;
}
.blank {
  display: inline-block;
  min-width: 72rpx;
  padding: 0 10rpx;
  margin: 0 6rpx;
  border-bottom: 5rpx solid #8a2f23;
  color: #8a2f23;
  font-weight: 700;
  text-align: center;
}
.blank.ok { background: rgba(63,95,82,.12); border-radius: 8rpx; }
.blank.no { background: rgba(138,47,35,.10); border-radius: 8rpx; }

.stage .tip {
  margin-top: 34rpx;
  font-size: 24rpx;
  color: #a89a83;
  letter-spacing: 3rpx;
}

.opts {
  margin: 10rpx 32rpx 0;
  display: flex;
  flex-wrap: wrap;
  gap: 22rpx;
}
.opt {
  width: calc(50% - 11rpx);
  height: 108rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255,255,255,.9);
  border: 1rpx solid #e0d5c1;
  border-radius: 18rpx;
  font-size: 34rpx;
  color: #2a2216;
  letter-spacing: 3rpx;
}
.opt .ol {
  width: 40rpx;
  font-size: 26rpx;
  color: #fff;
  margin-right: 6rpx;
}
.opt.ok {
  background: #3f5f52;
  border-color: #3f5f52;
  color: #fff;
}
.opt.no {
  background: #8a2f23;
  border-color: #8a2f23;
  color: #fff;
}
.opt.dim { opacity: .45; }

.note {
  margin: 34rpx 32rpx 0;
  padding: 28rpx 30rpx;
  background: rgba(255,255,255,.7);
  border-left: 6rpx solid rgba(138,47,35,.5);
  border-radius: 0 16rpx 16rpx 0;
  opacity: 0;
  transform: translateY(10rpx);
  transition: all .3s ease;
}
.note.show {
  opacity: 1;
  transform: translateY(0);
}
.note .nsrc {
  font-size: 24rpx;
  color: #8a2f23;
  letter-spacing: 3rpx;
}
.note .nfull {
  margin-top: 14rpx;
  font-size: 25rpx;
  line-height: 2;
  color: #5f5443;
  white-space: pre-line;
}

.res {
  padding: 80rpx 0 0;
  text-align: center;
}
.res .rtag {
  font-size: 22rpx;
  letter-spacing: 12rpx;
  color: #9a8c76;
}
.res .rtitle {
  margin-top: 30rpx;
  font-size: 96rpx;
  font-weight: 700;
  letter-spacing: 20rpx;
  color: #8a2f23;
  text-indent: 20rpx;
}
.res .rsub {
  margin-top: 18rpx;
  font-size: 26rpx;
  color: #7a6c58;
  letter-spacing: 4rpx;
}
.res .rscore {
  margin-top: 60rpx;
  font-size: 120rpx;
  font-weight: 700;
  color: #241c12;
  line-height: 1;
}
.res .rscore .u {
  font-size: 30rpx;
  font-weight: 400;
  margin-left: 10rpx;
  color: #8a8175;
}
.res .rstat {
  margin: 50rpx auto 0;
  width: 620rpx;
  display: flex;
  border-top: 1rpx solid #e2d8c6;
  border-bottom: 1rpx solid #e2d8c6;
}
.res .rstat .cell {
  flex: 1;
  padding: 28rpx 0;
}
.res .rstat .cell + .cell { border-left: 1rpx solid #e2d8c6; }
.res .rstat .num { font-size: 40rpx; color: #8a2f23; font-weight: 700; }
.res .rstat .lab { margin-top: 8rpx; font-size: 22rpx; color: #8a8175; }

.newbest {
  margin: 26rpx auto 0;
  display: inline-block;
  font-size: 22rpx;
  letter-spacing: 4rpx;
  color: #fff;
  background: #8a2f23;
  padding: 8rpx 26rpx;
  border-radius: 999rpx;
}
